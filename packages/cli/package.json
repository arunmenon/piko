{
  "name": "@pi/cli",
  "version": "0.2.0",
  "description": "Interactive and headless CLI for the piko coding-agent harness",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "pi": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunmenon/piko.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/arunmenon/piko#readme",
  "bugs": {
    "url": "https://github.com/arunmenon/piko/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@pi/ai": "0.2.0",
    "@pi/core": "0.2.0"
  }
}
